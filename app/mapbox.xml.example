<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Copiar este archivo a src/main/res/values/mapbox.xml y completar con el
      token PÚBLICO de Mapbox (pk.*) — ver docs/CREDENTIALS_SETUP.md sección 2.
      mapbox.xml está en .gitignore: GitHub push protection lo bloquea como
      secreto aunque el token sea público, así que no se commitea.
      Este archivo vive fuera de res/values/ a propósito: el merger de
      recursos de Android procesa TODO archivo dentro de res/values/ como
      recurso y rechaza cualquiera que no termine en .xml exacto.
    -->
    <string name="mapbox_access_token" translatable="false">pk.TU_TOKEN_PUBLICO_ACA</string>
</resources>
