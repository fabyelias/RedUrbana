# Android / Gradle
*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build
**/build/
/captures
.externalNativeBuild
.cxx
*.keystore
*.jks
.kotlin/
hs_err_pid*.log
*.hprof

# AAB/APK generados (ej. "Generate Signed App Bundle" con destino app/): no
# son código fuente, no van al repo.
*.aab
*.apk

# Nunca debe subirse ningún token secreto al repo — el MAPBOX_DOWNLOADS_TOKEN
# vive en ~/.gradle/gradle.properties (fuera de este repositorio), nunca acá.
gradle.properties.local

# GitHub push protection lo detecta como secreto aunque sea el token pk.*
# público. Cada dev lo completa a mano a partir de mapbox.xml.example
# (ver docs/CREDENTIALS_SETUP.md sección 2).
/app/src/main/res/values/mapbox.xml

# Misma copia del token público de Mapbox, pero legible desde data-transport
# (WalkingDirectionsClient) — ver mapbox_token.xml.example.
/core/core-common/src/main/res/values/mapbox_token.xml

# Keystore de firma de release: contraseñas + ruta al .jks/.keystore, nunca
# al repo (el .jks/.keystore en sí ya lo cubren los patrones *.keystore/*.jks
# de arriba). Ver docs/CREDENTIALS_SETUP.md sección 5.
app/keystore.properties

# Cuenta de servicio de Google Play (publicación automática a Play Console):
# nunca al repo, mismo criterio que el keystore. En CI se reconstruye desde
# un secret de GitHub — ver .github/workflows/publish-play-internal.yml.
app/play-service-account.json
